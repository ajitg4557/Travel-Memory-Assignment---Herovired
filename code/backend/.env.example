# ------------------------------------------------------------------
# DevOps Task Board - backend configuration
# Copy this file to .env and fill in the values:
#   Linux/macOS : cp .env.example .env
#   Windows     : copy .env.example .env
# NEVER commit your real .env file to GitHub (.gitignore already blocks it).
# ------------------------------------------------------------------

# Port the Node.js app listens on.
# On EC2, Nginx listens on port 80 and forwards /api/* to this port.
PORT=5000

# MongoDB connection string.
# Get it from MongoDB Atlas -> your cluster -> Connect -> Drivers.
# Replace <db_username>, <db_password> and <cluster-host> with your own values,
# and keep "/taskboard" before the "?" - that is the database name.
MONGO_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/taskboard?retryWrites=true&w=majority

# Name shown in the UI (dev, staging, prod...)
APP_ENV=dev

# Allow the "Generate CPU load" button (POST /api/stress) - used for the
# Auto Scaling demo. Set to false when you are not running the demo.
ENABLE_STRESS=true

# Only for running on your laptop WITHOUT Nginx/Docker:
# when true, Node also serves the frontend files on http://localhost:5000
SERVE_FRONTEND=false
