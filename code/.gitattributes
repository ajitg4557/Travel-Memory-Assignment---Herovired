# Shell scripts, Nginx templates and systemd units must keep Linux (LF) line
# endings, even when the repo is cloned or edited on Windows.
# CRLF line endings break bash ("bad interpreter") and systemd on EC2.
*.sh        text eol=lf
*.template  text eol=lf
*.service   text eol=lf
*.yml       text eol=lf
*.bat       text eol=crlf
